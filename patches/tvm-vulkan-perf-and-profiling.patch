+// Resolve the device from the first tensor argument and block until its queue is
+// idle, so the surrounding host clock actually spans GPU execution.
+static void ProfileSyncDevice(const std::vector<ffi::AnyView>& call_args, int offset,
+                              int num_args) {
+  for (int i = 0; i < num_args; ++i) {
+    auto t = call_args[i + offset].as<Tensor>();
+    if (!t) continue;
+    DLDevice dev = t->device();
+    if (auto* api = DeviceAPI::Get(dev, /*allow_missing=*/true)) {
+      api->StreamSync(dev, nullptr);
+    }
+    return;
+  }
+}
